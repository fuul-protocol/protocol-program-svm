{
  "name": "@fuul/sdk-solana",
  "version": "0.5.7",
  "description": "SDK to interact with the Full Solana program",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "prepare": "husky || true",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "docs": "typedoc --options typedoc.json",
    "docs:serve": "serve ./docs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+git@github.com:fuul-protocol/protocol-program-svm.git"
  },
  "keywords": [
    "Solana",
    "Anchor",
    "Web3"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fuul-protocol/protocol-program-svm/issues"
  },
  "homepage": "https://github.com/fuul-protocol/protocol-program-svm#readme",
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@noble/ed25519": "3.0.0",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "1.98.4",
    "borsh": "2.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.1",
    "@typescript-eslint/eslint-plugin": "8.46.3",
    "@typescript-eslint/parser": "8.46.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "glob": "13.0.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "serve": "14.2.5",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "4.9.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=23"
  }
}
